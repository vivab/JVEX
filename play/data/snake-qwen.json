{"id":"snake-qwen","title":"Змейка • Qwen","model":"Groq / qwen/qwen3.8-27b","generatedBy":"JVEX public API, run 42600545724","adaptations":["Responsive canvas width on narrow phones"],"html":"<html lang=\"ru\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Змейка</title>\n<style>\nbody { display: flex; flex-direction: column; align-items: center; font-family: sans-serif; background: #222; color: #fff; min-height: 100vh; margin:0;}\ncanvas { border: 2px solid #0f0; background: #000; margin-top: 10px; }\n#ctrl { margin-top: 10px; display: grid; grid-template-columns: repeat(3, 60px); gap: 5px; }\nbutton { font-size: 20px; padding: 15px; background: #444; color: white; border: none; border-radius: 5px; }\nbutton:active { background: #666; }\n#score { font-size: 18px; margin: 5px; }\ncanvas{max-width:96vw;height:auto}</style>\n</head>\n<body>\n<h2>Змейка</h2>\n<div id=\"score\">Счёт: 0</div>\n<canvas id=\"game\" width=\"400\" height=\"400\"></canvas>\n<div id=\"ctrl\">\n<button style=\"visibility: hidden;\">-</button>\n<button onclick=\"setDir(0,-1)\">↑</button>\n<button style=\"visibility: hidden;\">-</button>\n<button onclick=\"setDir(-1,0)\">←</button>\n<button onclick=\"start()\">Пуск</button>\n<button onclick=\"setDir(1,0)\">→</button>\n<button style=\"visibility: hidden;\">-</button>\n<button onclick=\"setDir(0,1)\">↓</button>\n<button style=\"visibility: hidden;\">-</button>\n</div>\n<script>\nconst cvs = document.getElementById('game'), ctx = cvs.getContext('2d');\nconst grid = 20, cols = 20, rows = 20;\nlet snake, dx, dy, food, score, gameOn, loop;\n\nfunction init() {\n    snake = [{x: 10, y: 10}];\n    dx = 0; dy = 1;\n    score = 0;\n    gameOn = true;\n    document.getElementById('score').innerText = 'Счёт: 0';\n    spawnFood();\n    clearInterval(loop);\n    loop = setInterval(step, 100);\n}\n\nfunction spawnFood() {\n    do {\n        food = { x: Math.floor(Math.random() * cols), y: Math.floor(Math.random() * rows) };\n    } while (snake.some(s => s.x === food.x && s.y === food.y));\n}\n\nfunction setDir(x, y) {\n    if (gameOn && (x !== 0 || y !== 0)) {\n        if (x === -dx && y === -dy) return;\n        dx = x; dy = y;\n    }\n}\n\nfunction step() {\n    if (!gameOn) return;\n    const head = { x: snake[0].x + dx, y: snake[0].y + dy };\n    if (head.x < 0 || head.y < 0 || head.x >= cols || head.y >= rows || snake.some(s => s.x === head.x && s.y === head.y)) {\n        gameOn = false;\n        clearInterval(loop);\n        alert('Игра окончена! Счёт: ' + score);\n        return;\n    }\n    snake.unshift(head);\n    if (head.x === food.x && head.y === food.y) {\n        score++;\n        document.getElementById('score').innerText = 'Счёт: ' + score;\n        spawnFood();\n    } else {\n        snake.pop();\n    }\n    draw();\n}\n\nfunction draw() {\n    ctx.fillStyle = 'black';\n    ctx.fillRect(0, 0, cvs.width, cvs.height);\n    ctx.fillStyle = 'red';\n    ctx.fillRect(food.x * grid, food.y * grid, grid, grid);\n    ctx.fillStyle = 'lime';\n    snake.forEach(s => ctx.fillRect(s.x * grid, s.y * grid, grid, grid));\n}\n\nfunction start() { init(); }\n\nwindow.addEventListener('keydown', e => {\n    const k = e.key;\n    if (k === 'ArrowUp' || k === 'w' || k === 'ц') setDir(0, -1);\n    if (k === 'ArrowDown' || k === 's' || k === 'ы') setDir(0, 1);\n    if (k === 'ArrowLeft' || k === 'a' || k === 'ф') setDir(-1, 0);\n    if (k === 'ArrowRight' || k === 'd' || k === 'в') setDir(1, 0);\n    if ((k === ' ' || k === 'Enter') && !gameOn) start();\n});\n\ninit();\n</script>\n</body>\n</html>"}
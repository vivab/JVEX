{"id":"tanks","title":"Танки","generatedBy":"JVEX public API","model":"Groq / openai/gpt-oss-120b","html":"<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>Танки</title>\n<style>\nbody{margin:0;background:#222;color:#fff;font-family:sans-serif;overflow:hidden}\n#game{background:#444;display:block;margin:auto}\n#ui{position:fixed;bottom:10px;left:50%;transform:translateX(-50%);display:flex;gap:5px}\n#ui button{width:60px;height:60px;font-size:20px}\n#info{position:fixed;top:10px;left:10px}\n</style>\n</head>\n<body>\n<canvas id=\"game\" width=\"400\" height=\"300\"></canvas>\n<div id=\"info\"></div>\n<div id=\"ui\">\n<button id=\"up\">↑</button>\n<button id=\"down\">↓</button>\n<button id=\"left\">←</button>\n<button id=\"right\">→</button>\n<button id=\"fire\">⭘</button>\n</div>\n<script>\nconst canvas=document.getElementById('game'),ctx=canvas.getContext('2d');\nconst info=document.getElementById('info');\nlet keys={};\ndocument.addEventListener('keydown',e=>keys[e.key]=true);\ndocument.addEventListener('keyup',e=>keys[e.key]=false);\n['up','down','left','right','fire'].forEach(id=>{\ndocument.getElementById(id).addEventListener('touchstart',e=>{e.preventDefault();keys[id]=true;});\ndocument.getElementById(id).addEventListener('touchend',e=>{e.preventDefault();keys[id]=false;});\n});\nlet player={x:180,y:260,w:30,h:30,c:'#0f0',hp:3};\nlet enemy={x:180,y:20,w:30,h:30,c:'#f00',hp:3,dir:1,cd:0};\nlet bullets=[];\nlet score=0,gameOver=false;\nfunction draw(){ctx.clearRect(0,0,canvas.width,canvas.height);\n[ player, enemy ].forEach(t=>{if(t.hp>0){ctx.fillStyle=t.c;ctx.fillRect(t.x,t.y,t.w,t.h);}});\nbullets.forEach(b=>{ctx.fillStyle=b.c;ctx.fillRect(b.x,b.y,b.w,b.h);});\ninfo.textContent=`Игрок: ${player.hp}  Враг: ${enemy.hp}  Счёт: ${score}`;\n}\nfunction update(){\nif(gameOver)return;\nif(keys.ArrowUp||keys.w||keys.up) player.y-=2;\nif(keys.ArrowDown||keys.s||keys.down) player.y+=2;\nif(keys.ArrowLeft||keys.a||keys.left) player.x-=2;\nif(keys.ArrowRight||keys.d||keys.right) player.x+=2;\nplayer.x=Math.max(0,Math.min(canvas.width-player.w,player.x));\nplayer.y=Math.max(0,Math.min(canvas.height-player.h,player.y));\nif(keys[' ']||keys.space||keys.fire){\nif(!player.shot){bullets.push({x:player.x+12,y:player.y-5,w:6,h:6,c:'#ff0',dy:-4,owner:'p'});player.shot=true;}\n}else player.shot=false;\nif(enemy.cd<=0){\nbullets.push({x:enemy.x+12,y:enemy.y+enemy.h,w:6,h:6,c:'#ff0',dy:4,owner:'e'});\nenemy.cd=120;\n}\nenemy.cd--;\nenemy.x+=enemy.dir*1;\nif(enemy.x<0||enemy.x+enemy.w>canvas.width) enemy.dir*=-1;\nbullets.forEach((b,i)=>{b.y+=b.dy;\nif(b.y<0||b.y>canvas.height){bullets.splice(i,1);return;}\nif(b.owner==='p'&&b.x<enemy.x+enemy.w&&b.x+b.w>enemy.x&&b.y<enemy.y+enemy.h&&b.y+b.h>enemy.y){\nenemy.hp--;score++;bullets.splice(i,1);\n}\nif(b.owner==='e'&&b.x<player.x+player.w&&b.x+b.w>player.x&&b.y<player.y+player.h&&b.y+b.h>player.y){\nplayer.hp--;bullets.splice(i,1);\n}\n});\nif(player.hp<=0||enemy.hp<=0){\ngameOver=true;\nsetTimeout(()=>{if(confirm((player.hp?'Победа!':'Поражение!')+' Restart?'))location.reload();},100);\n}\n}\nfunction loop(){update();draw();requestAnimationFrame(loop);}\nloop();\n</script>\n</body>\n</html>"}
{"id":"snake","title":"Змейка","model":"Groq / openai/gpt-oss-120b","generatedBy":"JVEX public API verified run 42599338848","html":"<!-- file=index.html -->\n<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Змейка</title>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <style>\n        * { box-sizing: border-box; margin: 0; padding: 0; }\n        body {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            font-family: Arial, sans-serif;\n            background: #111;\n            color: #eee;\n            min-height: 100vh;\n            justify-content: center;\n        }\n        #gameContainer {\n            position: relative;\n            width: 100%;\n            max-width: 400px;\n        }\n        canvas {\n            background: #222;\n            display: block;\n            width: 100%;\n            height: auto;\n        }\n        #score {\n            position: absolute;\n            top: 8px;\n            left: 8px;\n            font-size: 1.2rem;\n            background: rgba(0,0,0,0.5);\n            padding: 4px 8px;\n            border-radius: 4px;\n        }\n        .controls, .ui-buttons {\n            margin-top: 10px;\n            display: flex;\n            flex-wrap: wrap;\n            justify-content: center;\n            gap: 8px;\n        }\n        .btn {\n            padding: 10px 16px;\n            font-size: 1rem;\n            border: none;\n            border-radius: 4px;\n            background: #4a90e2;\n            color: #fff;\n            cursor: pointer;\n            min-width: 60px;\n            user-select: none;\n        }\n        .btn:active { background: #357ab8; }\n        .dir-btns {\n            display: grid;\n            grid-template-columns: 60px 60px 60px;\n            grid-template-rows: 60px 60px 60px;\n            gap: 4px;\n        }\n        .dir-btn { background: #555; }\n        .dir-btn:active { background: #777; }\n        .empty { visibility: hidden; }\n        @media (max-width: 360px) {\n            .btn { padding: 8px 12px; font-size: 0.9rem; }\n            .dir-btns { grid-template-columns: 50px 50px 50px; grid-template-rows: 50px 50px 50px; }\n            .dir-btn { width: 50px; height: 50px; }\n        }\n    </style>\n</head>\n<body>\n    <h1>Змейка</h1>\n    <div id=\"gameContainer\">\n        <canvas id=\"gameCanvas\" width=\"400\" height=\"400\"></canvas>\n        <div id=\"score\">Счёт: 0</div>\n    </div>\n\n    <div class=\"ui-buttons\">\n        <button id=\"startBtn\" class=\"btn\">Старт</button>\n        <button id=\"restartBtn\" class=\"btn\" disabled>Перезапуск</button>\n    </div>\n\n    <div class=\"controls\">\n        <div class=\"dir-btns\">\n            <div class=\"empty\"></div>\n            <button class=\"btn dir-btn\" id=\"upBtn\">▲</button>\n            <div class=\"empty\"></div>\n\n            <button class=\"btn dir-btn\" id=\"leftBtn\">◄</button>\n            <div class=\"empty\"></div>\n            <button class=\"btn dir-btn\" id=\"rightBtn\">►</button>\n\n            <div class=\"empty\"></div>\n            <button class=\"btn dir-btn\" id=\"downBtn\">▼</button>\n            <div class=\"empty\"></div>\n        </div>\n    </div>\n\n    <script>\n        // ------- Конфигурация -------\n        const canvas = document.getElementById('gameCanvas');\n        const ctx = canvas.getContext('2d');\n        const scoreEl = document.getElementById('score');\n        const startBtn = document.getElementById('startBtn');\n        const restartBtn = document.getElementById('restartBtn');\n\n        const cellSize = 20;                     // размер клетки\n        const rows = canvas.height / cellSize;   // количество строк\n        const cols = canvas.width / cellSize;    // количество столбцов\n\n        // ------- Состояние -------\n        let snake = [];          // массив координат {x, y}\n        let direction = {x: 1, y: 0}; // начальное направление (вправо)\n        let nextDirection = direction; // буфер для ввода\n        let food = null;\n        let score = 0;\n        let gameInterval = null;\n        const fps = 10;          // скорость змейки\n\n        // ------- Утилиты -------\n        function randomFood() {\n            let f;\n            do {\n                f = {\n                    x: Math.floor(Math.random() * cols),\n                    y: Math.floor(Math.random() * rows)\n                };\n            } while (snake.some(seg => seg.x === f.x && seg.y === f.y));\n            return f;\n        }\n\n        function drawCell(x, y, color) {\n            ctx.fillStyle = color;\n            ctx.fillRect(x * cellSize, y * cellSize, cellSize, cellSize);\n        }\n\n        function resetGame() {\n            snake = [{x: Math.floor(cols/2), y: Math.floor(rows/2)}];\n            direction = {x: 1, y: 0};\n            nextDirection = direction;\n            food = randomFood();\n            score = 0;\n            scoreEl.textContent = `Счёт: ${score}`;\n            ctx.clearRect(0,0,canvas.width,canvas.height);\n            draw();\n        }\n\n        function gameOver() {\n            clearInterval(gameInterval);\n            gameInterval = null;\n            alert('Игра окончена! Ваш счёт: ' + score);\n            startBtn.disabled = false;\n            restartBtn.disabled = false;\n        }\n\n        function update() {\n            // применяем буфер ввода\n            direction = nextDirection;\n\n            const head = {x: snake[0].x + direction.x, y: snake[0].y + direction.y};\n\n            // проверка столкновения со стенами\n            if (head.x < 0 || head.x >= cols || head.y < 0 || head.y >= rows) {\n                gameOver();\n                return;\n            }\n\n            // проверка столкновения с телом\n            if (snake.some(seg => seg.x === head.x && seg.y === head.y)) {\n                gameOver();\n                return;\n            }\n\n            snake.unshift(head); // добавить голову\n\n            // съели еду?\n            if (head.x === food.x && head.y === food.y) {\n                score++;\n                scoreEl.textContent = `Счёт: ${score}`;\n                food = randomFood();\n            } else {\n                snake.pop(); // удалить хвост, если не съели\n            }\n\n            draw();\n        }\n\n        function draw() {\n            ctx.clearRect(0,0,canvas.width,canvas.height);\n\n            // поле\n            drawCell(food.x, food.y, '#ff5555');\n\n            // тело змейки\n            snake.forEach((seg, i) => {\n                drawCell(seg.x, seg.y, i===0 ? '#00ff00' : '#009900');\n            });\n        }\n\n        // ------- Управление -------\n        function setDirection(dx, dy) {\n            // запретить мгновенный разворот\n            if (dx === -direction.x && dy === -direction.y) return;\n            nextDirection = {x: dx, y: dy};\n        }\n\n        document.addEventListener('keydown', e => {\n            switch (e.key) {\n                case 'ArrowUp': case 'w': case 'W': setDirection(0, -1); break;\n                case 'ArrowDown': case 's': case 'S': setDirection(0, 1); break;\n                case 'ArrowLeft': case 'a': case 'A': setDirection(-1, 0); break;\n                case 'ArrowRight': case 'd': case 'D': setDirection(1, 0); break;\n            }\n        });\n\n        // Сенсорные кнопки\n        document.getElementById('upBtn').addEventListener('click', () => setDirection(0,-1));\n        document.getElementById('downBtn').addEventListener('click', () => setDirection(0,1));\n        document.getElementById('leftBtn').addEventListener('click', () => setDirection(-1,0));\n        document.getElementById('rightBtn').addEventListener('click', () => setDirection(1,0));\n\n        // Кнопки старта/перезапуска\n        startBtn.addEventListener('click', () => {\n            startBtn.disabled = true;\n            restartBtn.disabled = true;\n            resetGame();\n            gameInterval = setInterval(update, 1000 / fps);\n        });\n\n        restartBtn.addEventListener('click', () => {\n            if (gameInterval) clearInterval(gameInterval);\n            startBtn.disabled = true;\n            restartBtn.disabled = true;\n            resetGame();\n            gameInterval = setInterval(update, 1000 / fps);\n        });\n\n        // Инициализация (показать стартовую заставку)\n        resetGame();\n    </script>\n</body>\n</html>"}
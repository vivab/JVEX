{"id":"breakout","title":"Арканоид","model":"Groq / openai/gpt-oss-120b","generatedBy":"JVEX public API","html":"<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Арканоид</title>\n<style>\nbody{margin:0;background:#111;color:#fff;font-family:sans-serif;display:flex;flex-direction:column;align-items:center}\n#game{border:2px solid #555;background:#000}\n#info{margin:10px}\nbutton{padding:5px 10px;font-size:14px}\n</style>\n</head>\n<body>\n<canvas id=\"game\" width=\"480\" height=\"320\"></canvas>\n<div id=\"info\">Score: <span id=\"score\">0</span> | Lives: <span id=\"lives\">3</span></div>\n<button id=\"restart\">Restart</button>\n<script>\nconst canvas=document.getElementById('game'), ctx=canvas.getContext('2d');\nconst w=canvas.width, h=canvas.height;\nlet score=0, lives=3, paddle, ball, bricks, running=true;\n\nfunction init(){\n  score=0; lives=3; running=true;\n  paddle={x:(w-80)/2, y:h-15, w:80, h:10, speed:6};\n  ball={x:w/2, y:h-30, r:6, vx:3, vy:-3};\n  bricks=[];\n  const rows=5, cols=8, bw=50, bh=15, pad=5, offsetTop=30, offsetLeft=30;\n  for(let r=0;r<rows;r++)for(let c=0;c<cols;c++){\n    bricks.push({x:offsetLeft+c*(bw+pad), y:offsetTop+r*(bh+pad), w:bw, h:bh, hit:true});\n  }\n  draw();\n}\nfunction draw(){\n  if(!running) return;\n  ctx.clearRect(0,0,w,h);\n  ctx.fillStyle='#0f0'; ctx.fillRect(paddle.x,paddle.y,paddle.w,paddle.h);\n  ctx.fillStyle='#ff0'; ctx.beginPath(); ctx.arc(ball.x,ball.y,ball.r,0,Math.PI*2); ctx.fill();\n  ctx.fillStyle='#09f'; bricks.forEach(b=>{if(b.hit)ctx.fillRect(b.x,b.y,b.w,b.h)});\n  update();\n  requestAnimationFrame(draw);\n}\nfunction update(){\n  ball.x+=ball.vx; ball.y+=ball.vy;\n  if(ball.x<ball.r||ball.x>w-ball.r) ball.vx*=-1;\n  if(ball.y<ball.r){ball.vy*=-1;}\n  else if(ball.y>h-ball.r){\n    lives--; document.getElementById('lives').textContent=lives;\n    if(lives===0){endGame('Game Over');return;}\n    resetBall();\n  }\n  if(ball.y+ball.r>paddle.y && ball.x>paddle.x && ball.x<paddle.x+paddle.w){\n    ball.vy*=-1;\n    let hitPos=(ball.x-(paddle.x+paddle.w/2))/(paddle.w/2);\n    ball.vx=3*hitPos;\n  }\n  for(let i=0;i<bricks.length;i++){\n    let b=bricks[i];\n    if(b.hit && ball.x>b.x && ball.x<b.x+b.w && ball.y-ball.r<b.y+b.h && ball.y+ball.r>b.y){\n      b.hit=false; ball.vy*=-1; score+=10;\n      document.getElementById('score').textContent=score;\n      if(bricks.every(br=>!br.hit)){endGame('You Win!');}\n      break;\n    }\n  }\n}\nfunction resetBall(){ball={x:w/2, y:h-30, r:6, vx:3, vy:-3};}\nfunction endGame(msg){running=false; alert(msg);}\nfunction movePaddle(x){paddle.x=Math.max(0,Math.min(w-paddle.w,x-paddle.w/2));}\ncanvas.addEventListener('mousemove',e=>movePaddle(e.offsetX));\ncanvas.addEventListener('touchmove',e=>{\n  e.preventDefault();\n  const rect=canvas.getBoundingClientRect();\n  const x=e.touches[0].clientX-rect.left;\n  movePaddle(x);\n});\ndocument.addEventListener('keydown',e=>{\n  if(e.key==='ArrowLeft')paddle.x=Math.max(0,paddle.x-paddle.speed);\n  else if(e.key==='ArrowRight')paddle.x=Math.min(w-paddle.w,paddle.x+paddle.speed);\n});\ndocument.getElementById('restart').addEventListener('click',init);\ninit();\n</script>\n</body>\n</html>"}